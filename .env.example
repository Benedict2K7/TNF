# ==========================================
# TAP N FOUND - ENVIRONMENT VARIABLES
# ==========================================

# Port (used for local development)
PORT=5000

# Environment mode (development or production)
NODE_ENV=development

# MongoDB Connection String (Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/tapnfound?retryWrites=true&w=majority
MONGODB_URI=

# Session Secret (Generate a random 32+ character string)
SESSION_SECRET=your_super_secret_session_key_here_change_this

# Email Provider Configuration (Optional for notifications)
# Option A: Resend API (Recommended for production / Vercel)
RESEND_API_KEY=
EMAIL_FROM=Tap N Found <onboarding@resend.dev>

# Option B: Gmail SMTP (For local testing)
SMTP_USER=
SMTP_PASS=

# Initial Admin Account Setup (Optional - only needed once to seed admin)
ADMIN_NAME=Tap N Found Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_secure_password_12_chars
